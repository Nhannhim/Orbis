#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode="${ORBIS_VISION_MODE:-fixture}"

if [[ "$mode" != "fixture" && "$mode" != "openai" ]]; then
  echo "ORBIS_VISION_MODE must be fixture or openai." >&2
  exit 2
fi

if [[ ! -d "$repo_dir/site/node_modules" ]]; then
  echo "Frontend packages are missing. Run: cd site && npm install" >&2
  exit 2
fi

python_bin="$repo_dir/.venv/bin/python"
if [[ ! -x "$python_bin" ]]; then
  python_bin="${PYTHON:-python3}"
fi

export ORBIS_VISION_MODE="$mode"
export ORBIS_HOST="${ORBIS_HOST:-127.0.0.1}"
export ORBIS_PORT="${ORBIS_PORT:-8080}"
export ORBIS_ALLOWED_ORIGIN="${ORBIS_ALLOWED_ORIGIN:-http://localhost:3000}"
export NEXT_PUBLIC_ORBIS_API_ORIGIN="${NEXT_PUBLIC_ORBIS_API_ORIGIN:-http://127.0.0.1:8080}"

if [[ "$mode" == "openai" && -z "${OPENAI_API_KEY:-}" && -f "$repo_dir/.env.local" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$repo_dir/.env.local"
  set +a
fi

# The command-line mode is authoritative even when .env.local has a default.
export ORBIS_VISION_MODE="$mode"

if [[ "$mode" == "openai" && -z "${OPENAI_API_KEY:-}" ]]; then
  echo "Live mode requires OPENAI_API_KEY in the environment or .env.local." >&2
  exit 2
fi

cleanup() {
  trap - EXIT INT TERM
  if [[ -n "${api_pid:-}" ]]; then kill "$api_pid" 2>/dev/null || true; fi
  if [[ -n "${site_pid:-}" ]]; then kill "$site_pid" 2>/dev/null || true; fi
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

echo "Starting Orbis API in $mode mode at http://127.0.0.1:${ORBIS_PORT}"
(cd "$repo_dir" && "$python_bin" run.py) &
api_pid=$!

echo "Starting Orbis workspace at http://localhost:3000/app/demo"
(cd "$repo_dir/site" && npm run dev) &
site_pid=$!

while kill -0 "$api_pid" 2>/dev/null && kill -0 "$site_pid" 2>/dev/null; do
  sleep 1
done

echo "One demo service stopped; shutting down the other." >&2
exit 1
